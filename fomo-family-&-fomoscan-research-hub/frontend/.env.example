# FE dev split: Next :3001 proxies /api/* to BE (see next.config.ts).
# Same-origin '' base in lib/api.ts keeps working; set this only for deploys
# where FE calls BE cross-origin directly (bypassing rewrites).
NEXT_PUBLIC_API_URL=""

# Local BE target for next.config.ts rewrites.
# Local dev: http://localhost:3000. Trong container compose: compose đã override
# thành http://backend:3000 (DNS nội bộ), không cần sửa file này.
BACKEND_URL="http://localhost:3000"

# Dev-only operator token shortcut trong AuthPanel (paste session token).
# Bật本地 dev: "1". Build prod KHÔNG set → ẩn khỏi public (login sạch cho demo).
NEXT_PUBLIC_SHOW_DEV_LOGIN=""
